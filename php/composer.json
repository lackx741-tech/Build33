{
  "name": "blower/php-gateway",
  "description": "PHP 8 RPC proxy and REST gateway for the Blower Web3 application.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "classmap": [
      "lib/",
      "config/",
      "middleware/",
      "services/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Blower\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "serve": "php -S 0.0.0.0:8080 index.php"
  },
  "config": {
    "sort-packages": true
  }
}
