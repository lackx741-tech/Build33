# ---- Runtime ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Blockchain ----
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_CHAIN_ID=56
BSC_TESTNET_CHAIN_ID=97

# ---- WalletConnect (frontend) ----
WALLETCONNECT_PROJECT_ID=

# ---- Cross-service ----
PHP_API_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# ---- Database ----
DATABASE_URL=postgres://blower:blower@localhost:5432/blower
PGSSLMODE=disable

# ---- Cache ----
CACHE_TTL=300

# ---- Security ----
API_KEY=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
