# Local development (`npm run dev`, Vite on :5173 talking to services started
# on the host). Leave these unset for the Docker/nginx build: the app then uses
# same-origin URLs and the reverse proxy routes /api, /rpc and /ws.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_PHP_API_URL=http://localhost:8080
VITE_WALLETCONNECT_PROJECT_ID=
VITE_CHAIN_ID=56
VITE_API_KEY=
